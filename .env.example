# Copy to .env and fill in.
OPENAI_API_KEY=sk-...

# Optional overrides - defaults shown
FKL_EXTRACTION_MODEL=gpt-4o-mini
FKL_RECONCILIATION_MODEL=gpt-4o-mini
FKL_EMBEDDING_MODEL=text-embedding-3-small
FKL_CHUNK_MAX_CHARS=6000
FKL_CHUNK_OVERLAP_RATIO=0.12
FKL_SIMILARITY_THRESHOLD=0.62
FKL_CANDIDATES_PER_FACT=6
FKL_MAX_CLUSTER_SIZE=5

# Concurrency (scalability knobs)
FKL_CHUNK_CONCURRENCY=5
FKL_DOCUMENT_CONCURRENCY=3
FKL_RECONCILE_CONCURRENCY=5
